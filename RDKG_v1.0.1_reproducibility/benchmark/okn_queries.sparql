# SPARQL used for the Proto-OKN condition (endpoint https://apps.okn.us/federation/sparql, graph https://purl.org/okn/frink/kg/rdkg v0.0.1), run 2026-10-19.
# Each query takes the 8 question entities of one category in a VALUES clause; results transcribed into answers_okn_llm.csv.

# Q01-Q08 disease -> phenotypes
PREFIX bl: <https://w3id.org/biolink/vocab/>
SELECT ?did ?pid WHERE { GRAPH <https://purl.org/okn/frink/kg/rdkg> {
 VALUES ?did {"MONDO:0005091" "MONDO:0010367" "MONDO:0011202" "MONDO:0009468" "MONDO:0019536" "MONDO:0010188" "MONDO:0024529" "MONDO:0007608"}
 ?d bl:id ?did . ?d bl:has_phenotype ?p . ?p bl:id ?pid } } ORDER BY ?did ?pid

# Q09-Q16 disease -> genes
PREFIX bl: <https://w3id.org/biolink/vocab/>
SELECT ?did ?gid WHERE { GRAPH <https://purl.org/okn/frink/kg/rdkg> {
 VALUES ?did {"MONDO:0006486" "MONDO:0011776" "MONDO:0006451" "MONDO:0009891" "MONDO:0008004" "MONDO:0005345" "MONDO:0005272" "MONDO:0016030"}
 ?d bl:id ?did . { ?d bl:related_to ?g } UNION { ?d bl:genetic_association ?g } . ?g bl:id ?gid . FILTER(STRSTARTS(?gid,"NCBIGene:")) } } ORDER BY ?did ?gid

# Q17-Q24 disease -> drugs
PREFIX bl: <https://w3id.org/biolink/vocab/>
SELECT ?did ?rid WHERE { GRAPH <https://purl.org/okn/frink/kg/rdkg> {
 VALUES ?did {"MONDO:0008674" "MONDO:0015277" "MONDO:0012481" "MONDO:0005820" "MONDO:0005823" "MONDO:0018752" "MONDO:0008219" "MONDO:0019543"}
 ?d bl:id ?did . ?r bl:treats ?d . ?r bl:id ?rid } } ORDER BY ?did ?rid

# Q25-Q32 phenotype -> diseases
PREFIX bl: <https://w3id.org/biolink/vocab/>
SELECT ?pid ?did WHERE { GRAPH <https://purl.org/okn/frink/kg/rdkg> {
 VALUES ?pid {"HP:0012511" "HP:0003250" "HP:0030270" "HP:0003378" "HP:0040223" "HP:0011094" "HP:0002508" "HP:0001927"}
 ?p bl:id ?pid . ?d bl:has_phenotype ?p . ?d bl:id ?did } } ORDER BY ?pid ?did

# Q33-Q40 drug -> treated diseases -> genes
PREFIX bl: <https://w3id.org/biolink/vocab/>
SELECT DISTINCT ?rid ?gid WHERE { GRAPH <https://purl.org/okn/frink/kg/rdkg> {
 VALUES ?rid {"DrugBank:DB11989" "DrugBank:DB01082" "DrugBank:DB13419" "DrugBank:DB00314" "DrugBank:DB00260" "DrugBank:DB14731" "DrugBank:DB11063" "DrugBank:DB00561"}
 ?r bl:id ?rid . ?r bl:treats ?d . { ?d bl:related_to ?g } UNION { ?d bl:genetic_association ?g } . ?g bl:id ?gid . FILTER(STRSTARTS(?gid,"NCBIGene:")) } } ORDER BY ?rid ?gid
